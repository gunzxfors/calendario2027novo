# ========================================================
# CONFIGURAÇÕES DO CHECKOUT PIX STONE / PAGAR.ME V5
# ========================================================
PORT=3000

# Chave Secreta da Pagar.me (Obtida no Dashboard: Configurações > Chaves de Acesso)
# Em ambiente de teste começa com "sk_test_..." e em produção com "sk_..."
PAGARME_SECRET_KEY=sk_test_sua_chave_secreta_aqui

# Chave Pública da Pagar.me (opcional)
PAGARME_PUBLIC_KEY=pk_test_sua_chave_publica_aqui

# URL Base da API Core V5 (padrão oficial)
PAGARME_BASE_URL=https://api.pagar.me/core/v5

# ========================================================
# WEBHOOK SECRET (OPCIONAL NA NETLIFY E PAGAR.ME V5):
# ========================================================
# Na Pagar.me V5, a assinatura HMAC automática da V1 foi descontinuada.
# O sistema protege os webhooks com dupla checagem obrigatória (Zero-Trust)
# consultando diretamente a API oficial com a Secret Key antes de liberar o acesso.
#
# Se você quiser adicionar uma camada extra de proteção por Token:
# 1. Defina qualquer palavra-chave secreta aqui, por exemplo:
#    PAGARME_WEBHOOK_SECRET=meu_token_secreto_pix_2027
# 2. No painel da Pagar.me, cadastre a URL incluindo o token:
#    https://seusite.netlify.app/api/webhooks/pagarme?token=meu_token_secreto_pix_2027
#
# Se preferir não usar token na URL, deixe esta variável VAZIA.
PAGARME_WEBHOOK_SECRET=

# Link de entrega do produto após o pagamento aprovado via Pix
ACCESS_DELIVERY_URL=https://drive.google.com/drive/folders/pack-calendarios-2027
